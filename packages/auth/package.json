{
  "name": "@exam/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@exam/test-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./password": {
      "@exam/test-source": "./src/password.ts",
      "types": "./dist/password.d.ts",
      "default": "./dist/password.js"
    },
    "./session": {
      "@exam/test-source": "./src/session.ts",
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./tokens": {
      "@exam/test-source": "./src/tokens.ts",
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs . && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@exam/domain": "workspace:*",
    "@exam/contracts": "workspace:*",
    "argon2": "^0.41.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@exam/source-fixture": "workspace:*",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
