      "types": "./dist/demo-seed.d.ts",
      "default": "./dist/demo-seed.js"
    },
    "./demo-seed-verify": {
      "@exam/test-source": "./src/demo-seed-verify.ts",
      "types": "./dist/demo-seed-verify.d.ts",
      "default": "./dist/demo-seed-verify.js"
    },
    "./e2eSeedOrchestrator": {
