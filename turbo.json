{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DEV_API_PORT",
        "VITE_PORT",
        "DB_HOST_PORT",
        "DATABASE_URL"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DB_URL",
        "DB_HOST_PORT",
        "TEST_DB_ISOLATION",
        "API_TEST_MAX_WORKERS",
        "TEST_INFRA_SCOPE",
        "TEST_SHARD_INDEX",
        "TEST_WORKER_ID",
        "TEST_ADMIN_DATABASE",
        "ALLOW_UNSAFE_TEST_DATABASE_URL"
      ]
    },
    "@exam/api#test": {
      "dependsOn": ["^build", "@exam/db#test"],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DB_URL",
        "DB_HOST_PORT",
        "TEST_DB_ISOLATION",
        "API_TEST_MAX_WORKERS",
        "TEST_INFRA_SCOPE",
        "TEST_SHARD_INDEX",
        "TEST_WORKER_ID",
        "TEST_ADMIN_DATABASE",
        "ALLOW_UNSAFE_TEST_DATABASE_URL"
      ]
    },
    "coverage": {
      "dependsOn": ["^build"],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DB_URL",
        "DB_HOST_PORT",
        "TEST_DB_ISOLATION",
        "API_TEST_MAX_WORKERS",
        "TEST_INFRA_SCOPE",
        "TEST_SHARD_INDEX",
        "TEST_WORKER_ID",
        "TEST_ADMIN_DATABASE",
        "ALLOW_UNSAFE_TEST_DATABASE_URL"
      ]
    },
    "@exam/api#coverage": {
      "dependsOn": ["^build", "@exam/db#coverage"],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DB_URL",
        "DB_HOST_PORT",
        "TEST_DB_ISOLATION",
        "API_TEST_MAX_WORKERS",
        "TEST_INFRA_SCOPE",
        "TEST_SHARD_INDEX",
        "TEST_WORKER_ID",
        "TEST_ADMIN_DATABASE",
        "ALLOW_UNSAFE_TEST_DATABASE_URL"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DB_URL",
        "DB_HOST_PORT",
        "TEST_DB_ISOLATION",
        "API_TEST_MAX_WORKERS",
        "TEST_INFRA_SCOPE",
        "TEST_SHARD_INDEX",
        "TEST_WORKER_ID",
        "TEST_ADMIN_DATABASE",
        "ALLOW_UNSAFE_TEST_DATABASE_URL"
      ]
    },
    "@exam/api#test:integration": {
      "dependsOn": ["^build", "@exam/db#test:integration"],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DB_URL",
        "DB_HOST_PORT",
        "TEST_DB_ISOLATION",
        "API_TEST_MAX_WORKERS",
        "TEST_INFRA_SCOPE",
        "TEST_SHARD_INDEX",
        "TEST_WORKER_ID",
        "TEST_ADMIN_DATABASE",
        "ALLOW_UNSAFE_TEST_DATABASE_URL"
      ]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "E2E_BASE_URL",
        "E2E_SHARD_TOTAL",
        "E2E_WORKERS_PER_SHARD",
        "E2E_TRACE",
        "CI"
      ]
    },
    "smoke": {
      "cache": false,
      "passThroughEnv": [
        "E2E_BASE_URL",
        "E2E_SHARD_TOTAL",
        "E2E_WORKERS_PER_SHARD",
        "E2E_TRACE",
        "CI"
      ]
    }
  }
}
