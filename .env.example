# pnpm dev reads DATABASE_URL below; Docker Compose reads the JWT_SECRET /
# POSTGRES_* block. First run: node scripts/generate-env.mjs (creates .env
# and fills both empty secrets with random values).
DATABASE_URL="postgresql://exam:exam@localhost:15432/exam"
APP_MODE="development"
NODE_ENV="development"
APP_PORT=3000
HOST="0.0.0.0"
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Docker Compose — required, no defaults; filled by scripts/generate-env.mjs
JWT_SECRET=
POSTGRES_PASSWORD=

# Docker Compose — defaults exam / exam
POSTGRES_USER=exam
POSTGRES_DB=exam

# Optional overrides — full reference: docs/deployment/mvp-deployment-runbook.md
# Host port (default 3000). CORS_ORIGIN / PUBLIC_WEB_ORIGIN default to
# http://localhost:<port>; set them to your machine's address for LAN access.
# APP_PORT=3001
# CORS_ORIGIN=http://192.168.1.5:3000
# PUBLIC_WEB_ORIGIN=http://192.168.1.5:3000

# Optional email (defaults: disabled, fake transport — nothing is sent)
# EMAIL_ENABLED=true
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.your-org.internal
# SMTP_USER=
# SMTP_PASSWORD=
