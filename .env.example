# Local dev (pnpm dev). Docker Compose: also uses the JWT_SECRET / POSTGRES_*
# block below. Copy to .env, then for Docker run: node scripts/generate-env.mjs
DATABASE_URL="postgresql://exam:exam@localhost:15432/exam"
APP_MODE="development"
NODE_ENV="development"
APP_PORT=3000
HOST="0.0.0.0"
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Docker Compose — required. Generate: node scripts/generate-env.mjs
JWT_SECRET=

# Docker Compose — required (no default in docker-compose.yml).
POSTGRES_USER=exam
POSTGRES_PASSWORD=exam
POSTGRES_DB=exam

# Email delivery — Docker Compose forwards these to app + email-worker.
# Defaults: disabled, fake transport (nothing is sent).
EMAIL_ENABLED=false
EMAIL_TRANSPORT=fake
EMAIL_FROM=no-reply@example.local
EMAIL_FROM_NAME=Exam Platform
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=60
# SMTP (only when EMAIL_TRANSPORT=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Docker Compose — optional; docker-compose.yml defaults to http://localhost:3000.
# Change to your machine's address for LAN access (e.g. http://192.168.1.5:3000).
# CORS_ORIGIN=http://localhost:3000
# PUBLIC_WEB_ORIGIN=http://localhost:3000
