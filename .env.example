# Local development environment (pnpm dev / pnpm db:up / pnpm test).
# Copy to .env:  cp .env.example .env
#
# ROOT-ONLY ENV FILES (#741): every env file lives at the repository root —
#   .env                 local development (this template)
#   .env.test.local      optional developer test override (vitest only)
#   .env.production      deployment (from .env.production.example, read ONLY
#                        by `docker compose --env-file .env.production`)
# DO NOT CREATE any other env file: no .env.local / .env.development* /
# .env.test / .env.production.local, and no nested apps/*/.env or
# packages/*/.env — none of them are sources in this repository, and
# `pnpm verify:static` (scripts/check-env-surface.mjs) fails loudly when any
# exists, even though git ignores them. Shell exports already win over this
# file for every variable.

# ── Dev host ports (one owner each; every consumer follows) ──────────────
#   DEV_API_PORT → API bind + Vite dev proxy target
#   VITE_PORT    → Vite dev server + API dev CORS/PUBLIC_WEB_ORIGIN default
#   DB_HOST_PORT → dev compose PostgreSQL host publish + constructed DATABASE_URL
# Override only when a port is taken on your machine.
# Full port map: docs/development/ports.md
DEV_API_PORT=3000
VITE_PORT=5173
DB_HOST_PORT=5432

# DATABASE_URL — leave UNSET for local dev: it is constructed from
# DB_HOST_PORT as postgresql://exam:exam@localhost:<DB_HOST_PORT>/exam
# (the docker-compose.dev.yml contract). Set it ONLY to point dev tooling at
# an external PostgreSQL; an explicit value always wins.
# DATABASE_URL="postgresql://exam:exam@localhost:5433/exam"

APP_MODE="development"
NODE_ENV="development"
HOST="0.0.0.0"
# Cookie Secure / HSTS / upgrade-insecure-requests derive from the canonical
# browser origin's scheme (PUBLIC_WEB_ORIGIN, default http://localhost:VITE_PORT
# in dev). Set PUBLIC_WEB_ORIGIN to an https:// origin to exercise Secure
# cookies locally — there is no separate cookie-transport toggle.
APP_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Testing needs no env setup: the harness self-provisions exam_test
# (docs/standards/testing.md §2). .env.test.local is an optional developer
# override only — vitest reads exactly .env + .env.test.local (nothing else)
# as its file sources.
