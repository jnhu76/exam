# DATABASE_URL — application/dev database. Tests never use this (they require
# a separate TEST_DATABASE_URL; see .env.test.example).
# Local dev (docker-compose.dev.yml maps host 15432 -> container 5432):
DATABASE_URL="postgresql://exam:exam@localhost:15432/exam"
# CI (GitHub Actions postgres service on localhost:5432):
# DATABASE_URL="postgresql://exam:exam@localhost:5432/exam"
# Production (Docker Compose): the docker-compose.yml contract composes
# DATABASE_URL from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB. Set
# POSTGRES_PASSWORD (required — see below); do NOT set DATABASE_URL here
# for the bundled Compose path. POSTGRES_PASSWORD has NO default in
# production (P6-007).

# Test database config lives in a separate template:
#   cp .env.test.example .env.test.local

# Redis (optional) — leave unset or empty to disable Redis.
# Production (Docker Compose): REDIS_URL="redis://redis:6379"
# Local dev: REDIS_URL="redis://localhost:6379"
# REDIS_URL=""
# Redis key prefix — use for test isolation (ADR-007) or namespace separation.
# REDIS_KEY_PREFIX=""
# Redis runtime mode (P7): off | optional | required.
#   unset    → "optional" when REDIS_URL is set, else "off"
#   off      → Redis client never created; local rate limiting (rollback lever)
#   optional → use Redis when healthy; degrade to local rate limiting when not
#   required→ startup fails if Redis is not ready within the startup window;
#              runtime loss fails closed (503 RATE_LIMIT_UNAVAILABLE)
# REDIS_MODE=""
# Bounded connection behavior (ms) — conservative LAN defaults:
# REDIS_CONNECT_TIMEOUT_MS=2000
# REDIS_COMMAND_TIMEOUT_MS=1000
# REDIS_STARTUP_TIMEOUT_MS=8000

# JWT_SECRET (required in production)
# Generate a secure random string: openssl rand -base64 32
# Development default is auto-applied when unset in non-production modes.
# JWT_SECRET=""
APP_MODE="development"
NODE_ENV="development"
APP_PORT=3000
HOST="0.0.0.0"
COOKIE_SECURE=false
CORS_ORIGIN="http://localhost:5173"

# Public web origin (P5-N1) — absolute origin used to build absolute URLs in
# server-generated content (currently: grade_notification Email links).
# Format: scheme + host + optional port ONLY. No path, query, hash, or trailing
# slash. Validated at boot via new URL(); invalid values fail fast.
#
# Local Vite development (default in non-production):
#   PUBLIC_WEB_ORIGIN=http://localhost:5173
#
# Docker same-origin deployment (API serves the built frontend):
#   PUBLIC_WEB_ORIGIN=http://localhost:3000
#
# Production (REQUIRED — must be the origin end-users can actually reach):
#   PUBLIC_WEB_ORIGIN=https://exam.example.com
#
# docker-compose.yml enforces this via ${PUBLIC_WEB_ORIGIN:?...} so a missing
# value fails at Compose expansion time, not at container startup.
PUBLIC_WEB_ORIGIN="http://localhost:5173"

# Runtime timezone (ADR-006) — display/log/diagnostics/fixture readability only.
# Does NOT change business-time comparison semantics; openAt/closeAt/deadlineAt
# are absolute instants. Must be a valid IANA timezone; invalid values fail fast.
# Do not use ambiguous abbreviations like CST.
APP_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Deployment mode.
# Phase 1 runtime is single-tenant only: one internal default organization.
# - unset or "singleTenant": Phase 1 runtime (default)
# - "multiTenant": rejected at startup; optional multiTenant is a Phase 4
#   platformization capability, not a current runnable mode.
DEPLOYMENT_MODE=singleTenant

# API Reference (Swagger UI) — disabled in production regardless
# API_DOCS_ENABLED="true"

# Rate limiting (in-memory)
# RATE_LIMIT_DISABLED="false"
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# Heartbeat scanner intervals (ms) — override defaults for E2E/fast testing.
# Production uses defaults (scan 30s, timeout 60s).
# HEARTBEAT_SCAN_INTERVAL_MS=30000
# HEARTBEAT_TIMEOUT_MS=60000

# ── Email (M3 — Email Outbox + SMTP Backend Foundation) ───────────────────
# Safe defaults: disabled, fake transport. A bare deployment sends nothing,
# needs no SMTP secret, and touches no network. Tests never require SMTP.
EMAIL_ENABLED=false
EMAIL_TRANSPORT=fake
EMAIL_FROM=no-reply@example.local
EMAIL_FROM_NAME=Exam Platform
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=60
# Fake sender deterministic mode: "success" (always resolves) or "failure"
# (always rejects with a fixed message, for testing the failure path).
EMAIL_FAKE_MODE=success

# SMTP (only required when EMAIL_TRANSPORT=smtp). When EMAIL_TRANSPORT=fake
# (default) these are never read.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false            # true = implicit TLS (port 465); false = STARTTLS (587)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_REQUIRE_TLS=true        # require STARTTLS upgrade when not implicit TLS
# SMTP_TLS_REJECT_UNAUTHORIZED=true  # NEVER set false in production
# SMTP_TLS_SERVERNAME=         # TLS SNI/servername override (e.g. for IP/proxy hosts)
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=10000

# Feature flags (Phase 2+ optional features)
# FEATURE_RESTORE_FRONTEND="false"
# FEATURE_MANUAL_EXAM_OPEN_CLOSE="false"
# FEATURE_LIVE_SCORE_LIST="false"

# Frontend API base URL — empty string means same-origin proxy (Vite dev default).
# VITE_API_BASE_URL=""

# Docker Compose (production). The bundled docker-compose.yml REQUIRES
# POSTGRES_PASSWORD (P6-007: ${POSTGRES_PASSWORD:?...} — Compose fails to
# expand if it is unset; there is no functional fallback). The same value
# is composed into the API and worker DATABASE_URL. JWT_SECRET,
# CORS_ORIGIN, and PUBLIC_WEB_ORIGIN are also required for the API and
# the email worker. These dev defaults below are for local dev only;
# copy to .env and replace with strong production values before
# `docker compose up`.
POSTGRES_USER=exam
# Production: replace with a strong generated password. Required.
POSTGRES_PASSWORD=exam
POSTGRES_DB=exam
# JWT_SECRET — required in production (no default in the bundled Compose).
# Generate a secure random string: openssl rand -base64 32
# JWT_SECRET=""
# CORS_ORIGIN — required in production (no default in the bundled Compose).
# CORS_ORIGIN="https://exam.your-org.internal"
# PUBLIC_WEB_ORIGIN — required in production (no default in the bundled Compose).
# PUBLIC_WEB_ORIGIN="https://exam.your-org.internal"
# REDIS_URL — optional. Leave unset to disable Redis (P6-010 / ADR-001).
# Set only when enabling the optional `redis` Compose profile
# (`docker compose --profile redis up`).
# REDIS_URL="redis://redis:6379"

# Seed data configuration (optional). DEV/TEST ONLY — the baseline seed
# (packages/db/src/seed.ts) ships known default credentials and refuses
# to run when APP_MODE=production (P6-008). Production bootstrap is
# `node dist/scripts/bootstrap-admin.js` (explicit credentials).
# SEED_ORG_NAME="Default Organization"
# SEED_ORG_DISPLAY_NAME="Default Organization"
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD="admin123"
# SEED_ADMIN_NAME="Admin"
# SEED_CANDIDATE_USERNAME="candidate"
# SEED_CANDIDATE_PASSWORD="candidate123"
# SEED_CANDIDATE_NAME="Candidate"
# SEED_CANDIDATE2_USERNAME="candidate2"
# SEED_CANDIDATE2_PASSWORD="candidate123"
# SEED_CANDIDATE2_NAME="Candidate 2"
