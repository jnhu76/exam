# Local development environment (pnpm dev / pnpm db:up / pnpm test).
# Copy to .env:  cp .env.example .env
# Development ONLY — Docker deployment uses .env.production.example →
# .env.production (docker compose --env-file .env.production), which this
# dev toolchain never reads.
# Do not create Vite mode files (.env.local / .env.development*): they are not
# part of this repo's contract; shell exports already win over this file.

# ── Dev host ports (one owner each; every consumer follows) ──────────────
#   DEV_API_PORT → API bind + Vite dev proxy target
#   VITE_PORT    → Vite dev server + API dev CORS/PUBLIC_WEB_ORIGIN default
#   DB_HOST_PORT → dev compose PostgreSQL host publish + constructed DATABASE_URL
# Override only when a port is taken on your machine.
# Full port map: docs/development/ports.md
DEV_API_PORT=3000
VITE_PORT=5173
DB_HOST_PORT=5432

# DATABASE_URL — leave UNSET for local dev: it is constructed from
# DB_HOST_PORT as postgresql://exam:exam@localhost:<DB_HOST_PORT>/exam
# (the docker-compose.dev.yml contract). Set it ONLY to point dev tooling at
# an external PostgreSQL; an explicit value always wins.
# DATABASE_URL="postgresql://exam:exam@localhost:5433/exam"

APP_MODE="development"
NODE_ENV="development"
HOST="0.0.0.0"
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# Testing needs no env setup: the harness self-provisions exam_test
# (docs/standards/testing.md §2). .env.test.local is an optional developer
# override only — there is no committed test template.
