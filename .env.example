DATABASE_URL="sqlite:./dev.db"
# Production (Docker Compose): DATABASE_URL="postgresql://exam:change-me@db:5432/exam"
# Tests use in-memory SQLite — never set DATABASE_URL for tests
# See docs/code-quality.md §13.5 for testing database strategy

# JWT_SECRET (required in production)
# Generate a secure random string: openssl rand -base64 32
# JWT_SECRET=""
NODE_ENV="development"
APP_PORT=3000
COOKIE_SECURE=false
CORS_ORIGIN="http://localhost:5173"

# Docker Compose (production)
POSTGRES_USER=exam
POSTGRES_PASSWORD=exam
POSTGRES_DB=exam

# Seed data configuration (optional)
# Uncomment and modify these values to customize the initial users created by pnpm db:seed
# SEED_ORG_NAME="Default Organization"
# SEED_ORG_DISPLAY_NAME="Default Organization"
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD="admin123"
# SEED_ADMIN_NAME="Admin"
# SEED_TEACHER_USERNAME="teacher"
# SEED_TEACHER_PASSWORD="teacher123"
# SEED_TEACHER_NAME="Teacher"
# SEED_CANDIDATE_USERNAME="candidate"
# SEED_CANDIDATE_PASSWORD="candidate123"
# SEED_CANDIDATE_NAME="Candidate"
