# Docker deployment environment (production Compose).
# Copy to .env.deploy and fill the required secrets:
#   node scripts/generate-env.mjs   # creates .env.deploy + fills secrets
# Then run the stack explicitly against it:
#   docker compose --env-file .env.deploy -f docker-compose.yml up -d --build
# (Passing --env-file makes Compose use ONLY this file for interpolation —
# the dev .env is never read for deployment. Conversely, no dev tooling
# (pnpm dev / vite / drizzle / vitest) ever reads this file.)
# Source-build verification merges the same flag:
#   docker compose --env-file .env.deploy \
#     -f docker-compose.yml -f docker-compose.build.yml up -d --build

# ── Required secrets (no defaults; generate-env fills, never rotates) ────
JWT_SECRET=
POSTGRES_PASSWORD=

# ── Topology ─────────────────────────────────────────────────────────────
POSTGRES_USER=exam
POSTGRES_DB=exam

# Host port publishing the app container (container-internal port stays
# 3000). CORS_ORIGIN / PUBLIC_WEB_ORIGIN default to
# http://localhost:<EXAM_PORT>; set them to your machine's address for LAN.
# EXAM_PORT=3000
# CORS_ORIGIN=http://192.168.1.5:3000
# PUBLIC_WEB_ORIGIN=http://192.168.1.5:3000

# APP_TIMEZONE=Asia/Shanghai
# TZ=Asia/Shanghai
# COOKIE_SECURE=false

# ── Optional: Redis (enable with `--profile redis`) ──────────────────────
# REDIS_PASSWORD=<secret>
# REDIS_URL=redis://:<secret>@redis:6379

# ── Optional: email (defaults: disabled, fake transport — nothing sent) ──
# EMAIL_ENABLED=true
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.your-org.internal
# SMTP_USER=
# SMTP_PASSWORD=

# ── Optional: first-install launchpad token ──────────────────────────────
# LAUNCHPAD_SETUP_TOKEN=
