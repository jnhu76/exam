# Test configuration template.
#
# This file is NOT loaded directly. Copy it to .env.test.local:
#   cp .env.test.example .env.test.local
#
# .env.test.local is git-ignored (see .gitignore).

# ── Test Database ─────────────────────────────────────────────────────────
# REQUIRED: Tests refuse to start without this.
# The database name MUST contain "test", "e2e", or "ci" (testDb name-safety
# guard). Never falls back to DATABASE_URL.

# Local dev (docker-compose.dev.yml maps host 15432 -> container 5432):
TEST_DATABASE_URL="postgresql://exam:exam@localhost:15432/exam_test"

# CI (GitHub Actions postgres service on localhost:5432):
# TEST_DATABASE_URL="postgresql://exam:exam@localhost:5432/exam_test"

# ── Test Isolation (ADR-007) ─────────────────────────────────────────────
# These variables only affect test / coverage / E2E execution.
# They are NOT read by the production runtime.

# DB isolation strategy. Valid: worker-database | file-schema (fallback).
# worker-database is required for parallel API tests via API_TEST_MAX_WORKERS.
TEST_DB_ISOLATION=worker-database

# Maximum vitest workers for apps/api parallel runs.
# Only valid with TEST_DB_ISOLATION=worker-database.
# Positive integer; values like 2 or 4 are typical for local dev.
# Not used by packages/db, web, or E2E tests.
API_TEST_MAX_WORKERS=4

# Manual worker ID override. Serial debugging ONLY.
# DANGEROUS in parallel or CI shard mode: all workers would share the same
# database and isolation is lost. Never set in CI.
# TEST_WORKER_ID=1

# Infrastructure scope prefix for worker DB names.
#   local  → exam_test_w{worker}
#   ci     → exam_test_s{shard}_w{worker}
# TEST_INFRA_SCOPE=local

# CI shard index. Vitest also reads --shard=N/M.
# TEST_SHARD_INDEX=1

# Bypass the test DB name safety check (name must contain test/e2e/ci).
# DANGEROUS: only enable if you explicitly accept tests writing to a
# non-standard database name. Never enable in CI or production.
# ALLOW_UNSAFE_TEST_DATABASE_URL=1

# Legacy alias for TEST_DATABASE_URL. Prefer TEST_DATABASE_URL.
# TEST_DB_URL="postgresql://exam:exam@localhost:15432/exam_test"

# ── Existing-env Playwright (pnpm test:e2e) ───────────────────────────────
# These are for existing-env-only Playwright runs. Managed WSL/Docker E2E
# runners manage their own database and lifecycle.

# Base URL the browser navigates to.
# Local / CI: http://localhost:3000
# Docker compose: http://examapp:3000
# E2E_BASE_URL=http://localhost:3000

# Total shard count. Values > 1 select blob reporting.
# E2E_SHARD_TOTAL=2

# Playwright workers inside one shard.
# Keep at 1 unless the database/server are independently isolated.
# E2E_WORKERS_PER_SHARD=1

# Retain traces on failure. Set to 1 to enable; unset or 0 disables.
# E2E_TRACE=1

# ── Managed E2E (NOT configured here) ────────────────────────────────────
# Managed E2E database targets are not configured in this template.
# - WSL: scripts/e2e/run-wsl.sh manages DATABASE_URL and exam_e2e.
# - Docker: pnpm e2e:docker uses an isolated container database.

# ── Email (tests) ────────────────────────────────────────────────────────
# Tests never need SMTP. Defaults are safe/disabled. Email tests inject
# senders/config explicitly; do NOT set EMAIL_TRANSPORT=smtp here.
EMAIL_ENABLED=false
EMAIL_TRANSPORT=fake
EMAIL_FAKE_MODE=success
