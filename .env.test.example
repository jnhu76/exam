# Test database configuration.
# This file documents the required env vars for running tests.
# Copy relevant values to your .env or set them in your shell.

# REQUIRED: Test database URL. Tests refuse to start without this.
# The database name MUST contain "test", "e2e", or "ci".
# Local dev (docker-compose.dev.yml maps host 15432 -> container 5432):
TEST_DATABASE_URL="postgresql://exam:exam@localhost:15432/exam_test"

# CI (PostgreSQL service on localhost:5432):
# TEST_DATABASE_URL="postgresql://exam:exam@localhost:5432/exam_test"

# E2E tests:
# TEST_DATABASE_URL="postgresql://exam:exam@localhost:5432/exam_e2e"

# Optional: Override DB name safety check (NOT recommended).
# ALLOW_UNSAFE_TEST_DATABASE_URL=1
