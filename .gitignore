# P7-C1 C1.1: canonical persistent data root (production bind mount).
# ${EXAM_DATA_ROOT:-./data} holds authoritative PostgreSQL state and optional
# Redis state. NEVER commit it. Deleting ./data/postgres deletes authoritative
# Exam state.
/data/

# Drill/smoke temp roots (self-cleaned by their traps; ignore hard-kill leftovers).
/.tmp-p7c1-drill-*/
/.tmp-p6-smoke-data-*/
