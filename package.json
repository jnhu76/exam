{
  "name": "exam",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/check-code-quality.mjs",
    "lint:copy": "node scripts/check-hardcoded-copy.mjs",
    "lint:arch": "node scripts/check-architecture.mjs",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "coverage": "turbo coverage",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "pnpm --filter @exam/db db:generate",
    "db:migrate": "pnpm --filter @exam/db db:migrate",
    "db:push": "pnpm --filter @exam/db db:push",
    "db:studio": "pnpm --filter @exam/db db:studio",
    "db:seed": "pnpm --filter @exam/api db:seed",
    "db:seed:demo": "pnpm --filter @exam/api db:seed:demo",
    "db:seed:demo:verify": "pnpm --filter @exam/api db:seed:demo:verify",
    "db:seed:e2e": "pnpm --filter @exam/api db:seed:e2e",
    "seed:e2e": "pnpm --filter @exam/api db:seed:e2e",
    "test:pg": "APP_MODE=test TEST_DATABASE_URL=\"postgresql://exam:exam@localhost:5432/exam_test\" DATABASE_URL=\"postgresql://exam:exam@localhost:5432/exam_test\" turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "e2e:docker": "bash scripts/e2e/run.sh",
    "smoke": "turbo smoke",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:copy && pnpm lint:arch && pnpm typecheck && pnpm verify:nodb-tests && pnpm verify:db-tests && pnpm build",
    "test:db": "pnpm --filter @exam/db test",
    "test:db:unit": "pnpm --filter @exam/db exec vitest run --exclude src/testWorkerDatabase.test.ts",
    "test:db:lifecycle": "pnpm --filter @exam/db exec vitest run src/testWorkerDatabase.test.ts",
    "test:api": "pnpm --filter @exam/api test",
    "test:api:fast": "TEST_DB_ISOLATION=worker-database API_TEST_MAX_WORKERS=4 pnpm --filter @exam/api test",
    "test:api:fast:max": "TEST_DB_ISOLATION=worker-database API_TEST_MAX_WORKERS=6 pnpm --filter @exam/api test",
    "test:api:shard": "pnpm --filter @exam/api exec vitest run",
    "coverage:db": "pnpm --filter @exam/db coverage",
    "coverage:db:lifecycle": "pnpm --filter @exam/db exec vitest run src/testWorkerDatabase.test.ts --coverage",
    "coverage:api": "pnpm --filter @exam/api coverage",
    "coverage:api:fast": "TEST_DB_ISOLATION=worker-database API_TEST_MAX_WORKERS=4 pnpm --filter @exam/api coverage",
    "test:nodb": "turbo test --filter=!@exam/db --filter=!@exam/api",
    "coverage:nodb": "turbo coverage --filter=!@exam/db --filter=!@exam/api",
    "verify:db-tests": "pnpm test:db && pnpm test:api && pnpm coverage:db && pnpm coverage:api",
    "verify:nodb-tests": "pnpm test:nodb && pnpm coverage:nodb",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm lint:copy && pnpm lint:arch && pnpm typecheck && pnpm verify:nodb-tests && pnpm test:db:unit && pnpm test:api:fast && pnpm build",
    "verify:full": "pnpm verify",
    "verify:static": "pnpm format:check && pnpm lint && pnpm lint:copy && pnpm lint:arch && pnpm typecheck",
    "verify:ci:post-static": "pnpm verify:nodb-tests && pnpm coverage:db && pnpm coverage:api && pnpm test:integration && pnpm build",
    "verify:ci": "pnpm verify:static && pnpm verify:ci:post-static",
    "verify:coverage-gate": "pnpm verify:ci",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.1.2"
}
