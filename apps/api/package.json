{
  "name": "@exam/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "node ../../scripts/check-code-quality.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:integration": "vitest run",
    "start": "node dist/server.js",
    "db:seed": "tsx src/seed.ts",
    "db:seed:demo": "tsx src/demo-seed.ts",
    "db:seed:demo:verify": "tsx src/demo-seed-verify.ts"
  },
  "dependencies": {
    "@exam/auth": "workspace:*",
    "@exam/contracts": "workspace:*",
    "@exam/db": "workspace:*",
    "@exam/domain": "workspace:*",
    "@exam/exam-engine": "workspace:*",
    "@exam/import-export": "workspace:*",
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
